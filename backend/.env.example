DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave DB_ENGINE unset (or anything other than "postgresql") to use SQLite for the demo.
DB_ENGINE=sqlite
